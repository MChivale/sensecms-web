Options -Indexes -MultiViews

<FilesMatch "(^\.|\.(?:env|ini|log|sql|sqlite3?|bak|key|pem)$)">
    Require all denied
</FilesMatch>

RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.sensecms\.com$ [NC]
RewriteRule ^ https://www.sensecms.com%{REQUEST_URI} [R=301,L]

# Fallback for Apache hosting where DocumentRoot cannot target public/.
RewriteRule ^public(?:/|$) - [L]
RewriteRule ^(.*)$ public/$1 [L]
