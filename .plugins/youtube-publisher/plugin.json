{
  "name": "Sense CMS YouTube Publisher",
  "slug": "youtube-publisher",
  "version": "0.2.0",
  "author": "QUANT Software House Limited",
  "type": "plugin",
  "description": "Uploads reviewed Sense CMS videos to connected YouTube channels with explicit audience and privacy controls.",
  "compatible_engine_version": ">=1.0.0 <2.0.0",
  "dependencies": [{"type": "addon", "slug": "social-publishing", "version": ">=0.5.0 <1.0.0"}],
  "permissions": [],
  "runtime": "runtime.php",
  "config_url": "/social-publishing/youtube",
  "icon": "youtube",
  "group": "Content distribution",
  "release_channel": "development",
  "license": {
    "model": "commercial-subscription",
    "billing_period": "year",
    "price": 15,
    "currency": "USD",
    "product_name": "Sense CMS YouTube Publisher Plugin",
    "product_model": "YouTube Publisher Plugin",
    "product_version": "1.0"
  },
  "social_publisher": {
    "platform": "youtube",
    "label": "YouTube channel",
    "handler": "src/provider.php",
    "max_message_length": 5000,
    "editor_options": true
  },
  "routes": [
    "/social-publishing/youtube",
    "/social-publishing/youtube/status",
    "/social-publishing/youtube/connect",
    "/social-publishing/youtube/callback",
    "/social-publishing/youtube/connections/{id}/disconnect"
  ],
  "changelog": [
    {"version": "0.2.0", "summary": "Use post video defaults and accept validated MP4 or WebM uploads without audio conversion."},
    {"version": "0.1.1", "summary": "Restore expired-token refresh for editor choices and uploads."},
    {"version": "0.1.0", "summary": "Connect multiple YouTube channels and upload reviewed MP4 videos with explicit privacy and audience settings."}
  ]
}
