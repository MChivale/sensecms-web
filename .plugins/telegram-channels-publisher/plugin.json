{
  "name": "Sense CMS Telegram Channels Publisher",
  "slug": "telegram-channels-publisher",
  "version": "0.1.0",
  "author": "QUANT Software House Limited",
  "type": "plugin",
  "description": "Publishes reviewed Sense CMS posts to connected Telegram channels through the official Sense CMS bot.",
  "compatible_engine_version": ">=1.0.0 <2.0.0",
  "dependencies": [{"type": "addon", "slug": "social-publishing", "version": ">=0.2.2 <1.0.0"}],
  "permissions": [],
  "runtime": "runtime.php",
  "config_url": "/social-publishing/telegram-channels",
  "icon": "send",
  "group": "Content distribution",
  "release_channel": "development",
  "license": {
    "model": "commercial-subscription",
    "billing_period": "year",
    "price": 15,
    "currency": "USD",
    "product_name": "Sense CMS Telegram Channels Plugin",
    "product_model": "Telegram Channels Plugin",
    "product_version": "1.0"
  },
  "social_publisher": {
    "platform": "telegram_channels",
    "label": "Telegram channel",
    "handler": "src/provider.php",
    "max_message_length": 3800
  },
  "routes": [
    "/social-publishing/telegram-channels",
    "/social-publishing/telegram-channels/connect",
    "/social-publishing/telegram-channels/connections/{id}/disconnect"
  ],
  "changelog": [
    {"version": "0.1.0", "summary": "Connect multiple Telegram channels through the official Sense CMS bot and publish reviewed posts with broker-side idempotency."}
  ]
}
